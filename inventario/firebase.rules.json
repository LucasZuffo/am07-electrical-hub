{
  "rules": {
    ".read": false,
    ".write": false,
    "am07Inventory": {
      "stock": {
        ".read": true,
        ".write": "newData.exists() && newData.child('revision').isNumber() && ((!data.exists() && newData.child('revision').val() >= 1) || newData.child('revision').val() === data.child('revision').val() + 1)",
        ".validate": "newData.hasChildren(['schemaVersion', 'revision'])",
        "schemaVersion": {
          ".validate": "newData.val() === 3"
        },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0 && newData.val() <= 9007199254740991"
        },
        "items": {
          "$index": {
            ".validate": "$index.matches(/^(0|[1-9][0-9]{0,2}|1[0-9]{3})$/) && newData.hasChildren(['id', 'name', 'category', 'quantity'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
            },
            "quantity": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "departments": {
              "$index": {
                ".validate": "($index === '0' || $index === '1') && (newData.val() === 'EL' || newData.val() === 'HV')"
              }
            }
          }
        },
        "datasheets": {
          "$key": {
            ".validate": "$key.matches(/^[A-Za-z0-9_-]{1,428}$/) && newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/) && root.child('am07Inventory/files').child(newData.val()).child('itemKey').val() === $key"
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "files": {
        "$fileId": {
          ".read": true,
          ".write": "$fileId.matches(/^[a-f0-9-]{36}$/) && ((!data.exists() && newData.exists()) || (!newData.exists() && root.child('am07Inventory/stock/datasheets').child(data.child('itemKey').val()).val() !== $fileId))",
          ".validate": "newData.hasChildren(['chunks', 'fileName', 'itemKey']) && newData.child('chunks/0').isString() && newData.child('chunks/0').val().beginsWith('data:application/pdf;base64,')",
          "fileName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "itemKey": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,428}$/)"
          },
          "chunks": {
            "$chunk": {
              ".validate": "$chunk.matches(/^(0|[1-9]|1[0-9]|2[0-6])$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 524288"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "am07Cost": {
      "plan": {
        ".read": true,
        ".write": "newData.exists() && newData.child('revision').isNumber() && ((!data.exists() && newData.child('revision').val() === 1) || newData.child('revision').val() === data.child('revision').val() + 1)",
        ".validate": "newData.hasChildren(['schemaVersion', 'revision', 'sourceId'])",
        "schemaVersion": {
          ".validate": "newData.val() === 1"
        },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0 && newData.val() <= 9007199254740991"
        },
        "sourceId": {
          ".validate": "newData.val() === 'am07-track-parts-20261119'"
        },
        "entries": {
          "$code": {
            ".validate": "$code.matches(/^[A-Za-z0-9_-]{1,80}$/)",
            "quantity": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "unitCost": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "conversion": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000"
            },
            "inventoryId": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
